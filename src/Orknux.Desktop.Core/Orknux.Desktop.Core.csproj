<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that is not Windows: the connection to the server, the protocol,
    reading a key chord, and writing a window out as text. Kept free of Windows
    so it builds and is tested on any machine, including the Linux one this is
    developed on.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orknux.Desktop.Core</RootNamespace>
  </PropertyGroup>

</Project>
